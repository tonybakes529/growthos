{
  "name": "growth-os",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-client coaching + growth operating platform (backend foundation)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:test": "bash scripts/test-db.sh",
    "db:docs": "python3 scripts/gen-data-model.py",
